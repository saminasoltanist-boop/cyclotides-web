   Martino, V and Claeson, P},
Title = {First cyclotide from Hybanthus (Violaceae)},
Journal = {PHYTOCHEMISTRY},
Year = {2001},
Volume = {58},
Number = {1},
Pages = {47-51},
Month = {SEP},
Abstract = {Hypa A, a novel macrocyclic polypeptide containing 30 amino acid
   residues, has been isolated from the n-butanol extract of the Argentine
   plant Hybanthus parviflorus. The sequence,
   cyclo-(SCVYIPCTITALLGCSCKNKVCYNGIPCAE), was determined by automated
   Edman degradation, quantitative amino acid analysis and nanospray
   MS/MS2. Three intramolecular disulfide bridges stabilize the cyclic
   peptide backbone of hypa A. Using these structural features to classify
   the peptide as a cyclotide, we extended the distribution of that
   substance class to a new genus. and now propose a uniform nomenclature
   for cyclotides. (C) 2001 Elsevier Science Ltd. All rights reserved.},
