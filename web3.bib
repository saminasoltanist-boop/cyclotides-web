@article{ WOS:000223600200014,
Author = {Göransson, U and Sjögren, M and Svangård, E and Claeson, P and Bohlin, L},
Title = {Reversible antifouling effect of the cyclotide cycloviolacin O2 against
   barnacles},
Journal = {JOURNAL OF NATURAL PRODUCTS},
Year = {2004},
Volume = {67},
Number = {8},
Pages = {1287-1290},
Month = {AUG},
Abstract = {Cycloviolacin O2, a plant peptide of the cyclotide family, is shown to
   have potent effects against fouling barnacles (Balanus improvisus), with
   complete inhibition of settlement at a concentration of 0.25 muM. The
   effect of cycloviolacin O2 against barnacles is reversible and nontoxic
   in the bioassay employed in these studies. Cycloviolacin O2 was isolated
   from the terrestrial plant Viola odorata by strong cation exchange and
   reversed-phase HPLC and identified by mass spectrometry following
   aminoethylation and enzymatic cleavage.},
