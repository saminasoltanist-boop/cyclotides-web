@article{ WOS:000187562600008,
Author = {Craik, DJ and Barry, DG and Clark, RJ and Daly, NL and Sando, L},
Title = {Structure-function studies of the plant cyclotides: The role of a
   circular protein backbone},
Journal = {JOURNAL OF TOXICOLOGY-TOXIN REVIEWS},
Year = {2003},
Volume = {22},
Number = {4},
Pages = {555-576},
Note = {International Symposium on Toxins and Natural Products in Honor of
   Professor Anthony T Yu, OKINAWA, JAPAN, NOV 17-19, 2002},
Abstract = {The traditional idea of proteins as linear chains of amino acids is
   being challenged with the discovery of miniproteins that contain a
   circular backbone. The cyclotide family is the largest group of circular
   proteins and is characterized by an amide-circularized protein backbone
   and six conserved cysteine residues. These conserved cysteines are
   paired to form a knotted network of disulfide bonds. The combination of
   the circular backbone and a cystine knot, known as the cyclic cystine
   knot (CCK) motif, confers exceptional stability upon the cyclotides.
   This review discusses the role of the circular backbone based on studies
   of both the oxidative folding of kalata B1, the prototypical cyclotide,
   and a comparison of the structure and activity of kalata B1 and its
   acyclic permutants.},
