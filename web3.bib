@article{ WOS:000170966800023,
Author = {Jennings, C and West, J and Waine, C and Craik, D and Anderson, M},
Title = {Biosynthesis and insecticidal properties of plant cyclotides:: The
   cyclic knotted proteins from Oldenlandia affinis},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2001},
Volume = {98},
Number = {19},
Pages = {10614-10619},
Month = {SEP 11},
Abstract = {Several members of the Rubiaceae and Violaceae families produce a series
   of cycloticles or macrocyclic peptides of 29-31 amino acids with an
   embedded cystine knot. We aim to understand the mechanism of synthesis
   of cyclic peptides in plants and have isolated a cDNA clone that encodes
   the cyclotide kalata Ell as well as three other clones for related
   cycloticles from the African plant Olden-landia affinis. The cDNA clones
   encode prepropeptides with a 20-aa signal sequence, an N-terminal
   prosequence of 46-68 amino acids and one, two, or three cyclotide
   domains separated by regions of about 25 aa. The corresponding
   cycloticles have been isolated from plant material, indicating that the
   cyclotide domains are excised and cyclized from all four predicted
   precursor proteins. The exact processing site is likely to lie on the
   N-terminal side of the strongly conserved GlyLeuPro or SerLeuPro
   sequence that flanks both sides of the cyclotide domain. Cyclotides have
   previously been assigned an antimicrobial function; here we describe a
   potent inhibitory effect on the growth and development of larvae from
   the Lepidopteran species Helicoverpa punctigera.},
