Title = {Triterpenoid saponin from Viola hondoensis W.!Becker et H!Boss.
   and their effect on MMP-1 and type I procollagen expression},
Journal = {ARCHIVES OF PHARMACAL RESEARCH},
Year = {2004},
Volume = {27},
Number = {7},
Pages = {730-733},
Month = {JUL},
Abstract = {Bioassay-guided fractionation has led to the isolation of triterpenoid
   saponins such as Acuto-side A
   (3-O-{[}O-beta-D-glucopyranosyl-(1-->2)-O-beta-D-glucopyranosyl]
   oleanolic acid) from the whole plants of Viola hondoensis. Among them,
   Saponin 1 exhibited potent inhibitory activity against matrix
   metalloproteinase (MMP)-1, and prevented the UV-induced changes in the
   MMP-1 expression. In addition, compound was isolated from this plant for
   the first time.},
