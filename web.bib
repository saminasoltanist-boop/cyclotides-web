@article{ WOS:001355235700001,
Author = {Arya, M. R. and Beevy, S. Suhara and Dan, Mathew},
Title = {Morphological and Genetic Diversity of Indian Clitoria ternatea
   L. (Faboideae, Fabaceae) Morphotypes Inferred from Floral Characters and
   SCoT Markers},
Journal = {PLANT MOLECULAR BIOLOGY REPORTER},
Year = {2025},
Volume = {43},
Number = {2, SI},
Pages = {815-832},
Month = {JUN},
Abstract = {Clitoria ternatea, belonging to the Fabaceae family (subfamily,
   Faboideae; tribe, Phaseolae; subtribe, Clitoriinae), is a perennial
   climber native to tropical and subtropical regions worldwide. Renowned
   for its medicinal properties and the presence of proteins called
   cyclotides, this plant has been extensively studied for its health and
   medicinal applications. The current research aims to elucidate the
   genetic diversity among seven morphotypes of Clitoria ternatea through
   both morphological and genetic analyses. This study aimed to investigate
   the morphological variability among seven morphotypes of C. ternatea,
   and found that the flower is the most variable structure among the
   morphotypes, with noticeable differences in corolla color and structure,
   stamens, and seeds. The morphological data highlight significant
   variations among the C. ternatea morphotypes. UPGMA cluster analysis
   revealed that the papilionaceous forms of C. ternatea var. ternatea
   grouped together, while the non-papilionaceous forms were grouped
   together as a second cluster. Using SCoT primers, the study identified a
   total of 210 polymorphic bands, with an average polymorphism rate of
   8.0\% from 698 bands. The polymorphic information content (PIC) ranged
   between 0.36 and 0.41. Cluster analysis based on Euclidean distance
   indicated the presence of two main clusters, distinguishing the seven
   morphotypes with Euclidean distances of 1.974 and 2.53. The first
   cluster included all single-petal morphotypes except for the Single
   Light Blue morphotype, which was grouped with the double-petal
   morphotypes. Both morphological and SCoT marker analyses effectively
   distinguished and clustered the morphotypes, demonstrating sufficient
   variability in the species using these methods.},
