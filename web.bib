@article{ WOS:001502495200001,
Author = {Zhou, Haiyan and Liang, Zhaohui and Wang, Chenyin and Blasco, Pilar and
   Ngai, Wai Lok and Xiao, Yisa and Chong, Tin Hang and Liu, Han and Zheng,
   Chaogu and Chan, Michael K. and Li, Xuechen},
Title = {Development of Nanomolar Affinity Miniprotein Inhibitors Targeting
   α-Synuclein Aggregation as Promising Therapeutic Agents for Parkinson's
   Disease},
Journal = {CCS CHEMISTRY},
Year = {2026},
Volume = {8},
Number = {2},
Month = {FEB},
Abstract = {Parkinson's disease (PD) is a debilitating neurodegenerative disorder
   characterized by the accumulation of alpha-synuclein (alpha-syn)
   aggregates in the brain. Developing effective therapies targeting
   alpha-syn has been challenging due to its intrinsically disordered
   nature. In this study, through screening a phagedisplayed small
   ubiquitin-like modifier 1 (SUMO1) (15-55)-biased library, we identified
   a 41-amino acid miniprotein, PD-6, as a novel nanomolar affinity binder
   of alpha-syn. PD-6 had good cell membrane permeability and serum
   stability. It effectively inhibited alpha-syn aggregation in SH-SY5Y
   cells. In Caenorhabditis elegans PD models, PD-6 rescued dopaminergic
   neuron loss and motor dysfunction to provide protection against
   neurodegeneration. The binding mode of PD-6 with alpha-syn was revealed
   by nuclear magnetic resonance investigation.},
