@article{ WOS:001669397900001,
Author = {Bouricha, El Mehdi and Magri, Meryam and Hakmi, Mohammed and El
   Guennouni, Kaoutar and El Hafidi, Naima and Bourais, Ilhame and
   Boutayeb, Saber},
Title = {Computational screening of Viola odorata cyclotides identifies
   Phyb C as potential PD-1 inhibitor for cancer immunotherapy},
Journal = {MOLECULAR DIVERSITY},
Year = {2026},
Volume = {30},
Number = {4},
Pages = {5841-5858},
Month = {AUG},
Abstract = {Blocking the PD-1/PD-L1 interaction is an effective immunotherapeutic
   approach, yet monoclonal antibodies (mAbs) used for this purpose remain
   limited by high cost, restricted tissue penetration, and immune-related
   adverse effects. Cyclotides, a family of cyclic peptides derived from
   Viola odorata, represent promising alternatives owing to their
   structural rigidity, stability, and potential to disrupt protein-protein
   interactions. In this study, a library of 66 cyclotides from V. odorata
   was screened in silico against the PD-1 receptor. Molecular docking
   identified Phyb C and Cycloviolacin O7 as the top candidates, both
   binding within the PD-1 epitopes, with predicted binding energies of -
   11.8 kcal/mol and - 11.6 kcal/mol, respectively. Molecular dynamics
   simulations of 1500 ns revealed that the PD-1\_cyclotide complexes
   persisted over the simulation time. Furthermore, RMSD, Rg, RMSF, PCA,
   and free energy surface analyses, showed that cyclotide binding
   modulates PD-1 conformational dynamics as compared to PD-1 apo form.
   Binding free energies were further calculated using MM-PBSA and MM-GBSA
   approaches, incorporating entropic contributions estimated by normal
   mode analysis. Phyb C displayed favourable MM-PBSA and MM-GBSA binding
   free energies, with Delta G(binding\_PB) of - 41.35 kcal/mol and Delta
   G(binding\_GB) of - 39.14 kcal/mol, whereas Cycloviolacin O7 showed less
   favourable values, with Delta G(binding\_PB) of - 25.65 kcal/mol and
   Delta G(binding\_GB) of - 29.68 kcal/mol. Overall, these results suggest
   Phyb C as a promising cyclotide scaffold for PD-1 targeting. However,
   this study is entirely computational, and the functional inhibition of
   the PD-1/PD-L1 signaling pathway remains to be validated experimentally.},
