@article{ WOS:000414562300003,
Author = {Feyzabadi, Zohre and Ghorbani, Fariba and Vazani, Yasaman and Zarshenas,
   Mohammad M.},
Title = {A Critical Review on Phytochemistry, Pharmacology of Viola
   odorata L. and Related Multipotential Products in Traditional
   Persian Medicine},
