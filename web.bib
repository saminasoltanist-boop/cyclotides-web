@inproceedings{ WOS:001466749900005,
Author = {Cheng, Yadi and Peng, Xubiao and Petkov, Peicho and Ilieva, Nevena},
Editor = {Georgiev, I and Kostadinov, H and Lilkova, E},
Title = {Studying the Geometry and Dynamics of Prospective Parkinson-Inhibitor
   MCoCP4 Variants with Modified Grafting Topologies},
Booktitle = {ADVANCED COMPUTING IN INDUSTRIAL MATHEMATICS, SIAM},
Series = {Studies in Computational Intelligence},
Year = {2025},
