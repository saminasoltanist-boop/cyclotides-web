@article{ WOS:000664151300020,
Author = {Rizwan, Zirwah and Aslam, Nosheen and Zafar, Farheen and Humma, Rashida
   and Jamil, Amer},
Title = {ISOLATION OF NOVEL CYCLOTIDE ENCODING GENES FROM SOME
   SOLANACEAE SPECIES AND EVOLUTIONARY LINK TO OTHER FAMILIES},
