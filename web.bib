@article{ WOS:000464767500040,
Author = {Rehm, Fabian B. H. and Jackson, Mark A. and De Geyter, Ewout and Yap,
   Kuok and Gilding, Edward K. and Durek, Thomas and Craik, David J.},
Title = {Papain-like cysteine proteases prepare plant cyclic peptide precursors
   for cyclization},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2019},
Volume = {116},
Number = {16},
Pages = {7831-7836},
Month = {APR 16},
Abstract = {Cyclotides are plant defense peptides that have been extensively
   investigated for pharmaceutical and agricultural applications, but key
   details of their posttranslational biosynthesis have remained elusive.
   Asparaginyl endopeptidases are crucial in the final stage of the
   head-to-tail cyclization reaction, but the enzyme(s) involved in the
   prerequisite steps of N-terminal proteolytic release were unknown until
   now. Here we use activity-guided fractionation to identify specific
   members of papain-like cysteine proteases involved in the N-terminal
   cleavage of cyclotide precursors. Through both characterization of
   recombinantly produced enzymes and in planta peptide cyclization assays,
   we define the molecular basis of the substrate requirements of these
   enzymes, including the prototypic member, here termed kalatase A. The
   findings reported here will pave the way for improving the efficiency of
   plant biofactory approaches for heterologous production of cyclotide
