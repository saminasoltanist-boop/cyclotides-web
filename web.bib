@article{ WOS:001695802500001,
Author = {Grover, Ankita and Singh, Sawraj and Mehta, Lovekesh and Kumar, Sanjay},
Title = {Molecular insights into anti-cancer cyclotides and their interaction
   with breast cancer targets: an in silico study},
Journal = {MOLECULAR DIVERSITY},
Year = {2026},
Volume = {30},
Number = {4},
Pages = {5989-6010},
Month = {AUG},
Abstract = {Cancer remains a major global health challenge, with breast cancer being
   the most prevalent malignancy in women and a leading cause of
   cancer-related mortality. This study employed an integrative in silico
   approach to analyse anticancer cyclotides, aiming to identify key
   physicochemical features associated with their potency and to explore
   their interactions with breast cancer targets. The study compared
   cyclotides for their physicochemical properties, sequence variations,
   and structural features, and identified key determinants of anticancer
   activity. Statistical analysis of eleven properties of potent and
   non-potent cyclotides was conducted, including molecular weight,
   isoelectric point (pI), net charge, GRAVY score, and counts of basic,
   acidic, aliphatic, aromatic, polar, and non-polar residues, as well as
   total residue count. The results showed that potent cyclotides exhibited
   significantly higher values of net charge, pI, GRAVY score, molecular
   weight, and higher counts of basic, aliphatic, non-polar, and total
   residues. Principal Component Analysis (PCA) was also applied to these
   features. Post-PCA analysis revealed that the principal components (PC1
   and PC2) correlated with IC50 values, clustering potent cyclotides and
   thereby highlighting the significance of these properties. Furthermore,
   molecular docking and dynamics simulations were conducted to investigate
   the interactions of selected cyclotides with two key breast cancer
   receptors, Estrogen Receptor (ER-alpha) and Epidermal Growth Factor
   Receptor (EGFR), to identify the amino acid interactions that drive
   receptor activation and conformational changes. Cliotide T12 (cT12) and
   Vibi G emerged as strong binders, with cT12 exhibiting superior binding
   stability and interaction profiles. In contrast, Vibi G showed weaker
   dynamics, especially with ER-alpha. These results reveal cT12 as a
   promising lead for further preclinical development in breast cancer
   therapy.},
