@article{ WOS:001473046400001,
Author = {Jaret, Alefia and Baghel, Vikas and Bisht, Gopal Singh},
Title = {Anticancer Peptides: Unveiling the Next Frontier in Cancer Treatment},
Journal = {INTERNATIONAL JOURNAL OF PEPTIDE RESEARCH AND THERAPEUTICS},
