@article{ WOS:001763941300001,
Author = {Hou, Tianyu and Wang, Yuanying and Yao, Yulong and Hu, Yangfan and
   Netala, Vasudeva Reddy and Li, Huizhen},
Title = {A Comprehensive Review on the Anticancer Activity of Plant Peptides and
   Their Mechanisms of Action},
Journal = {FOODS},
Year = {2026},
