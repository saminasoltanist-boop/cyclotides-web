@article{ WOS:000832387300003,
Author = {Niyomploy, Ploypat and Sangvanich, Polkit},
Title = {Imaging mass spectrometry as a novel Cys-rich peptide detection
   technique in plant tissue},
Journal = {INTERNATIONAL JOURNAL OF MASS SPECTROMETRY},
Year = {2022},
Volume = {477},
Month = {JUL},
Abstract = {A successful novel method for detecting Cys-rich peptides in plant
   tissue using MALDI-IMS is first reported. The novel method provides a
   rapid and robust screening method for peptide detection because
   extraction and purification processes are not required. In addition, the
   novel method also provides greater convenience for peptide
   characterization and determining peptide localization because it can
   perform these steps directly on tissue, resulting in the use of 10- to
   20-fold less plant sample compared to that required for conventional
   methods. As a result, the novel method is successful for peptide
   detection in tissue and is probably applicable for the detection of
   other active Cys-rich peptides. (C) 2022 Elsevier B.V. All rights
   reserved.},
