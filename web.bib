@article{ WOS:000438004700007,
Author = {Fang, Ge-Min and Chen, Xiao-Xu and Yang, Qian-Qian and Zhu, Liang-Jing
   and Li, Ning-Ning and Yu, Hai-Zhu and Meng, Xiang-Ming},
Title = {Discovery, structure, and chemical synthesis of disulfide-rich peptide
   toxins and their analogs},
Journal = {CHINESE CHEMICAL LETTERS},
Year = {2018},
Volume = {29},
Number = {7, SI},
Pages = {1033-1042},
Month = {JUL},
Note = {15th Chinese International Peptide Symposium (CPS), Tsinghua Univ,
   Shenzhen, PEOPLES R CHINA, JUL 04-06, 2018},
Abstract = {Recently, medicinal peptide molecules are of great interest to many
   international pharmaceutical companies, mainly because of their
   relatively lower research costs, shorter research cycles, and the
   greater likelihood of being drugs, when compared with traditional small
   molecules. Due to the great variety in molecule structures and the
   diverse biological functions, disulfide-rich peptide toxins have become
   a shining molecular library for the development of polypeptide drugs. In
   view of the increasing amount of related publications, here we summarize
   the discovery, structural elucidation and chemical synthesis of
   disulfide-rich peptide toxins and their analogs. (C) 2018 Chinese
   Chemical Society and Institute of Materia Medica, Chinese Academy of
   Medical Sciences. Published by Elsevier B.V. All rights reserved.},
Publisher = {ELSEVIER SCIENCE INC},
