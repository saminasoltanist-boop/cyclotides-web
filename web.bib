@article{ WOS:001690207900001,
Author = {Ruan, Binghui and Liu, Meng and Qin, Jiongwen and Jiang, Peng and
   Zhangsun, Dongting and Luo, Sulan and Wu, Yong},
Title = {Efficient hydrazide-mediated total synthesis of Mo<spacing
   diaeresis>bius cyclotides from Viola japonica and elucidation of the
   antibacterial mechanism of Vija 31},
Journal = {BIOCHEMICAL AND BIOPHYSICAL RESEARCH COMMUNICATIONS},
Year = {2026},
Volume = {807},
Month = {APR 2},
Abstract = {Cyclotides represent a unique family of plant-derived cyclic peptides
   with high structural stability and promising bioactivities, yet their
   pharmaceutical application is limited by low natural abundance and
   synthetic difficulty. Herein, we adopted an efficient hydrazide-mediated
   total synthesis strategy to prepare nine Mo<spacing diaeresis>bius
   subfamily cyclotides from Viola japonica transcriptomic data. Among
   them, Vija 31 exhibited remarkable antibacterial potency (MIC = 2 mu M
   against Acinetobacter baumannii and Bacillus subtilis, 64 mu M against
   Cryptococcus neoformans), along with low hemolytic activity (3.36\% at
   128 mu M). Circular dichroism spectroscopy and AlphaFold-3 modeling
   indicate Vija 31 adopts a compact (3-sheet/(3-turn conformation, which
   may contribute to its antibacterial activity. Scanning electron
   microscopy revealed Vija 31-induced bacterial membrane disruption
   (rupture and shrinkage), while nucleic acid and protein leakage assays
   confirmed concentration-dependent release of intracellular contents and
   time-kill kinetics demonstrated its concentration-dependent bactericidal
   activity. Optimization of hydrazide cyclization conditions using Vija 31
   as a model further improved reaction efficiency. This work establishes a
   versatile and scalable route for Mo<spacing diaeresis>bius cyclotide
   synthesis and identifies Vija 31 as a promising lead compound against
   drug-resistant bacteria.},
