@article{ WOS:000800593200001,
Author = {Dang, Tien T. and Harvey, Peta J. and Chan, Lai Yue and Huang, Yen-Hua
   and Kaas, Quentin and Craik, David J.},
Title = {Mutagenesis of cyclotide Cter 27 exemplifies a robust folding strategy
   for bracelet cyclotides},
Journal = {PEPTIDE SCIENCE},
Year = {2022},
Volume = {114},
Number = {6},
Month = {NOV},
Abstract = {In contrast to Mobius and trypsin inhibitor cyclotides, members of the
   bracelet subfamily are typically intractable to chemical synthesis and
   folding. In a significant advance in the field, the bracelet cyclotides
   ribe 33 and Cter 27 were successfully produced synthetically in moderate
   yield in a recent study. That synthetic method was a breakthrough as
   members of the bracelet subfamily of cyclotides had hitherto eluded
   attempts to be synthetically produced, apart from one report of cyO2
   production in which a complicated folding strategy was used. In the
   current study the successful in vitro folding of three mutants of
   bracelet cyclotide Cter 27 is reported. This study broadens our
   understanding of the folding of bracelet cyclotides and elucidates the
   three dimensional structure of synthetic Cter 27, providing a new class
   of cyclotide molecular grafting scaffold for drug design applications.},
