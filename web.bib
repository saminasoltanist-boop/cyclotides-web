@article{ WOS:001688876500001,
Author = {Dutta, Bamaprasad and Loo, Shining and Kam, Antony and Liu, Chuan-Fa and
   Tam, James P.},
Title = {Targeted Protein Degrader from Ginkgo to Mitigate Amyloid β-Induced
   Neurotoxicity},
Journal = {BIOCHEMISTRY},
Year = {2026},
Volume = {65},
Number = {5},
Pages = {545-558},
Month = {MAR 3},
Abstract = {Protein degradation through the autophagy-lysosome process by eukaryotic
   cells is a major pathway to remove unwanted proteins, organelles, and
   invading pathogens. It is also an emerging intervention strategy to
   selectively eliminate inaccessible toxic amyloid proteins to prevent
   amyloid beta (A beta)-induced neurotoxicity. Currently, there is no
   natural product-derived peptide that targets amyloid proteins for
   degradation through the autophagy-lysosome pathway. We recently
   discovered a new peptide family from Ginkgo biloba nuts, which we termed
   beta-ginkgotides. The prototype beta-gB1 is 20-residue in length,
   cross-braced by three disulfides, and stable to proteolytic degradation.
   Importantly, it has an LC3-interacting region (LIR) motif, which
   promotes selective autophagy to degrade harmful proteins and to prevent
   cell death. Here, we show that beta-gB1 is cell-penetrating, primarily
   entering cells through energy-dependent endocytosis, and protects A
   beta-induced neurotoxicity using an SH-SY5Y neuronal cell-based model.
   Functional studies using synthetic beta-gB1 revealed that it impedes A
   beta accumulation and reverses the altered gene expression associated
   with Alzheimer's disease (AD) pathophysiology induced by A beta.
   Importantly, beta-gB1 maintains cellular homeostasis and enhances the
   clearance of A beta aggregates through selective autophagy, thereby
   safeguarding neurons from A beta toxicity. Collectively, these results
   support that beta-ginkgotide is a first-in-class cysteine-rich peptide
   (CRP)-based targeted protein degrader and underscore its potential as a
   novel and promising neuroprotective therapeutic to manage A beta-induced
   neurotoxicity in AD and other neurodegenerative disorders.},
