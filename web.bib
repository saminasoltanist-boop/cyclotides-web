@article{ WOS:001814645200001,
Author = {Dang, Tien T. and Tran, Tam T. T. and Nguyen, Uyen N. P. and Pham, Son
   H. and Nguyen, Tuan H. N.},
Title = {Characterizationof Cyclotides via LC-MS/MS from theVietnamese Plant
   Bak.f.:Insights into Antimicrobial and Larvicidal Activities},
Journal = {JOURNAL OF NATURAL PRODUCTS},
Year = {2026},
Volume = {89},
Number = {8},
Pages = {2300-2313},
Month = {AUG 28},
Abstract = {Bak.f., a Vietnamese endemic species, is reported here for the first
   time as a source of cyclotides. LC-MS and LC - MS/MS analyses identified
   11 cyclotides (3.1-3.8 kDa) bearing the conserved cyclic cystine knot
   (CCK) motif, including four novel cyclotides designated Vian A, Vian B,
   Vian C, and Vian D. Fraction M1 contained eight cyclotides, including
   Vian A, whereas fractions M2 and M3 mainly contained Vian B/Vian C and
   Vian D, respectively. Vian D was successfully purified, sequenced, and
   evaluated for antimicrobial activity. The peptide mixtures M2 and Vian D
   showed antibacterial activity against , , and . Minimum inhibitory
