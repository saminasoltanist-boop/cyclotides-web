@article{ WOS:001800117600001,
Author = {Kumar, Vivek},
Title = {Plant antimicrobial peptides: Molecular diversity, membrane
   interactions, and roles in plant-microbe defense},
Journal = {PHYSIOLOGICAL AND MOLECULAR PLANT PATHOLOGY},
Year = {2026},
Volume = {145},
Month = {SEP},
Abstract = {Plant antimicrobial peptides are structurally diverse defense molecules
   that play essential roles in plant innate immunity and protection
   against microbial invasion. This review summarizes current advances in
   their biosynthesis, structural diversity, membrane-targeting mechanisms,
   and functions in plant-microbe interactions. Major peptide families,
   including defensins, thionins, lipid transfer proteins, cyclotides,
   hevein-like peptides, and related groups, are discussed alongside the
   emerging class of non-canonical antimicrobial peptides encoded by
   previously overlooked small open reading frames. Particular emphasis is
   placed on how precursor processing, structural organization, and
   peptide-membrane interactions govern antimicrobial activity and
   contribute to coordinated defense responses. The review also examines
   the integration of these peptides with broader plant defense networks
   and highlights recent progress in peptide engineering and translational
   applications for sustainable crop protection. Collectively, plant
   antimicrobial peptides represent promising biological tools for future
   agricultural and biotechnological innovation.},
