Number = {24},
Pages = {15424-15430},
Month = {DEC 16},
Abstract = {An artificial retroaldolase was developed using a 43-amino-acid-long
   miniprotein derived from the C-terminal domain of the MvaT protein. A
   series of rounds of rational optimization of activity was performed,
   included grafting of the active motif in the deft of the miniprotein,
   engineering the active site structure, and modifying the charge
   distribution on the surface of the miniprotein. It was proved that
   miniproteins of this size can be mutated to obtain an effective
   enzyme-like catalyst. Moreover, the possibility of tuning the catalyst
   efficiency by optimization of surface charge distribution was shown.},
