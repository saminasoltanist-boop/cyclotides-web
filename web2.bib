@article{ WOS:000277133900004,
Author = {Austin, Jeffrey and Kimura, Richard H. and Woo, Youn-Hi and Camarero,
   Julio A.},
Title = {In vivo biosynthesis of an Ala-scan library based on the cyclic peptide
   SFTI-1},
Journal = {AMINO ACIDS},
Year = {2010},
Volume = {38},
Number = {5},
Pages = {1313-1322},
Month = {MAY},
Abstract = {We present the in vivo biosynthesis of wild-type sunflower trypsin
   inhibitor 1 (SFTI-1) inside E. coli cells using an intramolecular native
   chemical ligation in combination with a modified protein splicing unit.
   SFTI-1 is a small backbone cyclized polypeptide with a single disulfide
   bridge. A small library containing multiple Ala mutants was also
   biosynthesized and its activity was assayed using a trypsin-binding
   assay. This study clearly demonstrates the exciting possibility of
   generating large cyclic peptide libraries in live E. coli cells, and is
   a critical first step for developing in vivo screening and directed
   evolution technologies using the cyclic peptide SFTI-1 as a molecular
   scaffold.},
