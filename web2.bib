@article{ WOS:000368061800008,
Author = {Nguyen, Giang K. T. and Cao, Yuan and Wang, Wei and Liu, Chuan Fa and
   Tam, James P.},
Title = {Site-Specific N-Terminal Labeling of Peptides and Proteins using
   Butelase 1 and Thiodepsipeptide},
Journal = {ANGEWANDTE CHEMIE-INTERNATIONAL EDITION},
Year = {2015},
Volume = {54},
Number = {52},
Pages = {15694-15698},
Month = {DEC 21},
Abstract = {An efficient ligase with exquisite site-specificity is highly desirable
   for protein modification. Recently, we discovered the fastest known
   ligase called butelase 1 from Clitoria ternatea for intramolecular
   cyclization. For intermolecular ligation, butelase 1 requires an excess
   amount of a substrate to suppress the reverse reaction, a feature
   similar to other ligases. Herein, we describe the use of
   thiodepsipeptide substrates with a thiol as a leaving group and an
   unacceptable nucleophile to render the butelase-mediated ligation
   reactions irreversible and in high yields. Butelase 1 also accepted
   depsipeptides as substrates, but unlike a thiodesipeptide, the
   desipeptide ligation was partially reversible as butelase 1 can tolerate
   an alcohol group as a poor nucleophile. The thiodesipeptide method was
   successfully applied in N-terminal labeling of ubiquitin and green
   fluorescent protein using substrates with or without a biotin group in
   high yields.},
