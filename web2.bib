@article{ WOS:000364435100037,
Author = {Hellinger, Roland and Koehbach, Johannes and Soltis, Douglas E. and
   Carpenter, Eric J. and Wong, Gane Ka-Shu and Gruber, Christian W.},
Title = {Peptidomics of Circular Cysteine-Rich Plant Peptides: Analysis of the
   Diversity of Cyclotides from Viola tricolor by Transcriptome and
   Proteome Mining},
Journal = {JOURNAL OF PROTEOME RESEARCH},
Year = {2015},
Volume = {14},
Number = {11},
Pages = {4851-4862},
Month = {NOV},
Abstract = {Cyclotides are plant-derived mini proteins. They are genetically encoded
   as precursor proteins that become post-translationally modified to yield
   circular cystine-knotted molecules. Because of this structural topology
   cydotides resist enzymatic degradation in biological fluids, and hence
   they are considered as promising lead molecules for pharmaceutical
   applications. Despite ongoing efforts to discover novel cydotides and
   analyze their biodiversity, it is not clear how many individual peptides
   a single plant specimen can express. Therefore, we investigated the
   transcriptome and c-ydotide peptidome of Viola tricolor. Transcriptome
   mining enabled the characterization of cydotide precursor architecture
   and processing sites important for biosynthesis of mature peptides. The
   cydotide peptidome was explored by mass spectrometry and bottom-up
   proteomics using the extracted peptide sequences as queries for database
   searching. In total 164 cydotides were discovered by nucleic acid and
   peptide analysis in V. tricolor. Therefore, violaceous plants at a
   global scale may be the source to as many as 150 000 individual
   cydotides. Encompassing the diversity of V. tricolor as a combinatorial
   library of bioactive peptides, this commercially available medicinal
   herb may be a suitable starting point for future bioactivity-guided
   screening studies.},
