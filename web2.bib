@article{ WOS:000239330500009,
Author = {Cemazar, Masa and Craik, David J.},
Title = {Factors influencing the stability of cyclotides: Proteins with a
   circular backbone and cystine knot motif},
Journal = {INTERNATIONAL JOURNAL OF PEPTIDE RESEARCH AND THERAPEUTICS},
Year = {2006},
Volume = {12},
Number = {3},
Pages = {253-260},
Month = {SEP},
Note = {6th Australian Peptide Conference, Whitsunday Isl, AUSTRALIA, OCT 09-14,
   2005},
Abstract = {Cyclotides are a large family of mini-proteins that have the
   distinguishing features of a head-to-tail cyclised backbone and a
   cystine knot formed by six conserved cysteine residues. They are present
   in plants from the Rubiaceae, Violaceae and Cucurbitaceae families. The
   unique structural features of the cyclotides make them extremely
   resistant to chemical, thermal and proteolytic degradation. In this
   article we review recent Studies from our laboratory that dissect the
   role of the individual structural elements in defining the stability of
   cyclotides. The resistance of cyclotides to chemical and proteolytic
   degradation is in large part due to the cystine knot, whereas the
   thermal stability is I composite of several features including the
   cystine knot, the cyclic backbone and the hydrogen bonding network. A
   range of biological activities of cyclotides is critically dependent oil
   the presence of the cyclic backbone.},
