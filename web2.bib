@article{ WOS:000251373300010,
Author = {Doernenburg, Heike and Seydel, Peter},
Title = {Effect of irradiation intensity on cell growth and kalata B1
   accumulation in Oldenlandia affinis cultures},
Journal = {PLANT CELL TISSUE AND ORGAN CULTURE},
Year = {2008},
Volume = {92},
Number = {1},
Pages = {93-99},
Month = {JAN},
Abstract = {Light irradiation had remarkable effects on callus growth of Oldenlandia
   affinis with an optimum intensity of 35 mu mol m(-2) (-1)supercript
   stop. Biosynthesis of kalata B1, the main cyclic peptide in O. affinis,
   was induced and triggered with rising irradiation intensities. The
   highest concentration of kalata B1, 0.49 mg g(-1)supercript stop DW
   characterised by the maximum productivity of 3.88 mu g per litre and day
   was analysed at 120 mu mol m(-2) (-1)supercript stop, although callus
   growth was repressed. The light saturation point was established to be
   35 mu mol m(-2) (-1)supercript stop, where kalata B1 productivity was in
   a similar order (3.41 mu g per day) due to the higher growth index. O.
   affinis suspension cultures were shown to accumulate comparable specific
   kalata B1 concentrations in a delayed growth associated production
   pattern. These were dependent on irradiation intensity (0.16 mg g(-1) at
   2 mu mol m(-2) (-1); 0.28 mg g(-1) at 35 mu mol m(-2-1)). The batch
   cultivation process resulted in a maximum productivity of 27.30 mu g per
   litre and day with culture doubling times of 1.16 d(-1). Submers
   operation represented a 8-fold product enhancement compared to callus
   cultivation.},
