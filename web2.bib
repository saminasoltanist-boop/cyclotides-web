@article{ WOS:000256511300017,
Author = {Doernenburg, Heike and Frickinger, Petra and Seydel, Peter},
Title = {Plant cell-based processes for cyclotides production},
Journal = {JOURNAL OF BIOTECHNOLOGY},
Year = {2008},
Volume = {135},
Number = {1},
Pages = {123-126},
Month = {MAY 20},
Abstract = {Cyclotides are naturally occurring mini-proteins that have a diverse
   range of therapeutically useful biological activities. Although a choice
   of approaches is available for cyclotides synthesis; most studies have
   involved the use of peptides extracted from plants. in order to
   facilitate the screening for structure-activity studies or to exploit
   them in drug development, a convenient and reliable route for the
   biosynthesis of cyclotides is of vital importance.
   Callus, suspension cultures and hydroponic plants of Oldenlandia affinis
   were established and have been evaluated for effective cyclotides
   production processes. The specific accumulation of kalata B1 was
   affected by cell differentiation as well as agitation; highest
   accumulation of 2.7 mg g(-1) dry weight was detected in agitated
   hydroponic plant cultures resulting in a productivity of 1.4 mg kalata
   B1 l(-1) day(-1). (C) 2008 Elsevier B.V. All rights reserved.},
