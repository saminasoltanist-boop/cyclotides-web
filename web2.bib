@article{ WOS:000282930400010,
Author = {Mylne, Joshua S. and Wang, Conan K. and van der Weerden, Nicole L. and
   Craik, David J.},
Title = {Cyclotides are a Component of the Innate Defense of Oldenlandia
   affinis},
Journal = {BIOPOLYMERS},
Year = {2010},
