@article{ WOS:000266812700013,
Author = {Tepkeeva, I. I. and Aushev, V. N. and Zborovskaya, I. B. and Demushkin,
   V. P.},
Title = {Cytostatic Activity of Peptide Extracts of Medicinal Plants on
   Transformed A549, H1299, and HeLa Cells},
Journal = {BULLETIN OF EXPERIMENTAL BIOLOGY AND MEDICINE},
Year = {2009},
Volume = {147},
Number = {1},
Pages = {48-51},
Month = {JAN},
Abstract = {Biological activity of peptide extracts of medicinal plants was studied
   on transformed non-small-cell lung carcinoma A549 cells, lung cancer
   H1299 cells, and cervical cancer HeLa cells at various cell densities.
   Cell survival and proliferation were evaluated 72 h after treatment with
   extracts in concentrations of 0.05, 0.25, and 0.5 mu g/mu l. The
   cytostatic effect was produced by peptide extracts of Camelia sinesis
   Kuntze, Inonotus obliquus, and a mixture Inula helenium L., Chelidonium
   majus L., Equisetum arvense L., and Inonotus obliquus. Peptide extracts
   of Hypericum perforatum L. and Laurus nobilis L. in the same
   concentrations had no effects on proliferative activity and growth of
   tumor cells.},
