@article{ WOS:000386691700002,
Author = {Nokihara, Kiyoshi and Kasama, Takeshi and Tominaga, Yuki and Kitagawa,
   Atsushi and Hirata, Akiyoshi and Ohyama, Takafumi and Yazawa, Itaru},
Title = {High throughput sequencing of cyclic peptide immobilized on a gel-type
   single bead},
Journal = {AMINO ACIDS},
Year = {2016},
Volume = {48},
Number = {11},
Pages = {2491-2499},
Month = {NOV},
Abstract = {Relatively larger scale peptide libraries immobilized on a gel-type
   solid support consisting of 24 natural and non-natural amino acids by
   the ``split and combine method{''} have been constructed to find
   interacting molecules. The diversity was ca. 200 millions of
   hexapeptides with cysteinyl residues forming cyclotide. Selected beads
   after screening can be sequenced by the conventional Edman degradation,
   although several restrictions and the problems are known. To resolve
   these, a novel combinatorial method involving partial acid hydrolysis
   followed by liquid chromatography with on-line mass spectrometric
   analyses has been established. Problems were uncovered in an early stage
   of the process. Uncertain assignment caused by byproducts derived from a
   cystine residue and other materials could be resolved by optimal
   hydrolysis conditions and derivatization before mass spectrometric
   analysis. Discrimination between Leu and Ile could be performed using
   high energy collision induced dissociation in the high resolution
   MALDI-TOF-MS/MS. The present optimized protocol is useful for discovery
   of sequences of interacting molecules and a second library construction.},
