@article{ WOS:000333662700039,
Author = {Burman, Robert and Gunasekera, Sunithi and Stromstedt, Adam A. and
   Goransson, Ulf},
Title = {Chemistry and Biology of Cyclotides: Circular Plant Peptides Outside the
   Box},
Journal = {JOURNAL OF NATURAL PRODUCTS},
