@article{ WOS:000298968200009,
Author = {Zheng Ji-Shen and Chang Hao-Nan and Shi Jing and Liu Lei},
Title = {Chemical synthesis of a cyclotide via intramolecular cyclization of
   peptide O-esters},
Journal = {SCIENCE CHINA-CHEMISTRY},
Year = {2012},
Volume = {55},
Number = {1, SI},
Pages = {64-69},
Month = {JAN},
Abstract = {Cyclotides constitute a fascinating family of circular proteins
   containing ca. 30 amino acid residues. They have a unique cyclic
   cysteine knot topology and exhibit remarkable thermal, chemical and
   enzymatic stabilities. These characteristics enable them to have a range
   of biological activities and promising pharmaceutical and agricultural
   applications. Here, we present a practical strategy for the chemical
   synthesis of cyclotides through the intramolecular ligation of fully
   unprotected peptide O-esters. This strategy involves the mild Fmoc
   solid-phase peptide synthesis of the peptide O-ester backbone, the
   head-to-tail cyclization of the cyclotide backbone by native chemical
   ligation, and the oxidative refolding to yield the natural knot protein.
   The simplicity and high efficiency of the strategy can be employed in
   the synthesis of artificial cyclotides for pharmaceutical applications.},
Publisher = {SCIENCE PRESS},
