@article{ WOS:000343751100021,
Author = {Wang, Conan K. and King, Gordon J. and Northfield, Susan E. and Ojeda,
   Paola G. and Craik, David J.},
Title = {Racemic and Quasi-Racemic X-ray Structures of Cyclic Disulfide-Rich
   Peptide Drug Scaffolds},
