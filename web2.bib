Title = {Isolation of antimicrobial peptides from New Zealand spinach
   Tetragonia tetragonioides},
Booktitle = {SCIENCE AND TECHNOLOGY AGAINST MICROBIAL PATHOGENS: RESEARCH,
   DEVELOPMENT AND EVALUATION},
Year = {2011},
Pages = {13-17},
Note = {International Conference on Antimicrobial Research, Valladolid, SPAIN,
   NOV 03-05, 2010},
Abstract = {The number of resistant pathogenic microbial species has increased in
   the last years. In the future it seems, there will be fewer
   possibilities to cure multiresistant infections by existing antibiotics.
   This can become a great problem for public health. One of the potential
   solutions seems to be short cationic, mainly hydrophobic peptides
   synthetised as a part of innate immunity of all living organisms. In our
   project, leaves of New Zealand spinach (Tetragonia tetragonioides) were
   chosen as a source of these peptides. We used several separation
   techniques based to gain fractions containing low molecular peptides.
   Antimicrobial activity of these peptide fractions was tested against
   gram-positive bacteria Staphylococcus aureus (clinical isolate) and
   gram-negative bacteria Pseudomonas aeruginosa DBM 3081. Mass
   spectrometry analysis of antimicrobial active fractions proved presence
   of low molecular peptides with molecular masses to 5 kDa.},
