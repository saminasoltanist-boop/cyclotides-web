@article{ WOS:000357664500007,
Author = {Bashiruddin, Nasir Kato and Nagano, Masanobu and Suga, Hiroaki},
Title = {Synthesis of fused tricyclic peptides using a reprogrammed translation
   system and chemical modification},
Journal = {BIOORGANIC CHEMISTRY},
Year = {2015},
Volume = {61},
Pages = {45-50},
Month = {AUG},
Abstract = {Here we report a unique method of ribosomally synthesizing fused
   tricyclic peptides. Flexizyme-assisted in vitro translation of a linear
   peptide with the N-terminal chloroacetyl group and four downstream
   cysteines followed by the addition of 1,3,5-tris(bromomethyl) benzene
   results in selective production of the fused tricyclic peptide. This
   technology can be used for the ribosomal synthesis of fused tricyclic
   peptide libraries for the in vitro selection of bioactive peptides with
   tricyclic topology. (C) 2015 The Authors. Published by Elsevier Inc.},
