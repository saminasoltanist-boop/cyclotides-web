@article{ WOS:000271137600003,
Author = {Sancheti, Harshkumar and Camarero, Julio A.},
Title = {``Splicing up{''} drug discovery. Cell-based expression and screening of
   genetically-encoded libraries of backbone-cyclized polypeptides},
