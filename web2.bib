@article{ WOS:000366874700016,
Author = {Nguyen, Giang K. T. and Kam, Antony and Loo, Shining and Jansson, Anna
   E. and Pan, Lucy X. and Tam, James P.},
Title = {Butelase 1: A Versatile Ligase for Peptide and Protein Macrocyclization},
Journal = {JOURNAL OF THE AMERICAN CHEMICAL SOCIETY},
Year = {2015},
Volume = {137},
Number = {49},
Pages = {15398-15401},
Month = {DEC 16},
Abstract = {Macrocydization is a valuable tool for drug design and protein
   engineering. Although various methods have been developed to prepare
   macrocydes, a general and efficient strategy is needed. Here we report a
   highly efficient method using butelase 1 to macrocyclize peptides and
   proteins ranging in sizes from 26 to >200 residues. We achieved
   cyclizations that are 20,000 times faster than sortase A, the most
   widely used ligase for protein cyclization. The reactions completed
   within minutes with up to 95\% yields.},
