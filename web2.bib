@article{ WOS:000288357400003,
Author = {Velasquez, Juan E. and van der Donk, Wilfred A.},
Title = {Genome mining for ribosomally synthesized natural products},
Journal = {CURRENT OPINION IN CHEMICAL BIOLOGY},
Year = {2011},
Volume = {15},
Number = {1},
Pages = {11-21},
Month = {FEB},
Abstract = {In recent years, the number of known peptide natural products that are
   synthesized via the ribosomal pathway has rapidly grown. Taking
   advantage of sequence homology among genes encoding precursor peptides
   or biosynthetic proteins, in silico mining of genomes combined with
   molecular biology approaches has guided the discovery of a large number
   of new ribosomal natural products, including lantipeptides,
   cyanobactins, linear thiazole/oxazole-containing peptides,
   microviridins, lasso peptides, amatoxins, cyclotides, and conopeptides.
   In this review, we describe the strategies used for the identification
   of these ribosomally synthesized and posttranslationally modified
   peptides (RiPPs) and the structures of newly identified compounds. The
   increasing number of chemical entities and their remarkable structural
   and functional diversity may lead to novel pharmaceutical applications.},
