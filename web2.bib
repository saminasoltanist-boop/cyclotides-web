@article{ WOS:000283468300014,
Author = {Toiu, Anca and Oniga, Ilioara and Tamas, Mircea},
Title = {MORPHOLOGICAL AND ANATOMICAL RESEARCHES ON VIOLA ARVENSIS MURRAY
   (VIOLACEAE)},
Journal = {FARMACIA},
Year = {2010},
Volume = {58},
Number = {5},
Pages = {654-659},
Month = {SEP-OCT},
Abstract = {The aim of this work was to carry out a morphological and anatomical
   study on the stem, leaf and stipel of Viola arvensis Murray by optical
   microscopy (OM) and scan electronic microscopy (SEM). We have shown some
   differential macroscopical characteristics that are necessary in order
   to identify this species and to emphasize some differential
   microscopical characteristics: the bifacial structure of the leaf and
   leaf's unicellular trichomes, the bifacial structure of the stipule,
   closely related to the leaf, the solid inclusions, the type of the
   vascular bundles, and we have made some micrometrical measurements. The
   images achieved by SEM means showed some differential characteristics
   concerning the trichomes and stomata and they represent elements of
   novelty in our country and abroad. Our results may serve as a criterion
   for interspecific differentiation and may have taxonomic value in the
   Viola genus.},
