Title = {Neuroprotective Activity of Viola mandshurica Extracts on
   Hydrogen Peroxide-Induced DNA Damage and Cell Death in PC 12 Cells},
Booktitle = {NATURAL COMPOUNDS AND THEIR ROLE IN APOPTOTIC CELL SIGNALING PATHWAYS},
