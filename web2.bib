@article{ WOS:000248861900011,
Author = {Boy, Regine Garcia and Haberkorn, Uwe and Mier, Walter},
Title = {Stabilisation of small proteins for their use as pharmacological
   scaffolds - why knot?},
Journal = {CHIMICA OGGI-CHEMISTRY TODAY},
Year = {2007},
Volume = {25},
Number = {3, S},
Pages = {37-39},
Abstract = {Proteins and peptlides e manifold functions in nature and have long been
   used as pharmacologically active compounds. A major drawback in their
   pharmaceutical applicability, however, is their lack of stability
   towards chemical, enzymatic and thermal degradation. Small knotted
   peptides, such as knottins and cyclotides, are newly discovered stable
   compounds isolated from plants, animals, fungi and bacteria. Due to
   their extraordinary stability, some of them even withstand treatment
   with boiling water. Besides disposing of a variety of natural targets
   and characteristics and thus potential therapeutic use, cyclotides and
   knottins have been used as scaffolds to create new pharmacologically
   active agents. Furthermore, despite their complicated knotted structure,
   the chemical synthesis using automated solid phase synthesis has been
   well established.},
