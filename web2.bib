@article{ WOS:000359816600009,
Author = {Mollica, Adriano and Costante, Roberto and Stefanucci, Azzurra and
   Novellino, Ettore},
Title = {Cyclotides: a natural combinatorial peptide library or a bioactive
   sequence player?},
Journal = {JOURNAL OF ENZYME INHIBITION AND MEDICINAL CHEMISTRY},
Year = {2015},
Volume = {30},
Number = {4},
Pages = {575-580},
Month = {AUG},
Abstract = {In this perspective review, we focalized our attention on the
   application of cyclotides in drug discovery. To date, two principal
   approaches have been explored since now: (i) the use of cyclotides as
   scaffold in which bioactive peptides can be grafted to improve
   stability, oral bioactivity and binding to GPCRs; (ii) their application
   as natural peptides library. For these reasons, cyclotides probably
   represent today a step further in the development of new tools in drug
   design.},
