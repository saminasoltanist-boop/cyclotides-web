@article{feng-jie_pair_2018,
	address = {24, TONGJIA XIANG, NANJING, 210009, PEOPLES R CHINA},
	title = {A pair of cyclopeptide epimers from the seeds of {Celosia} argentea},
	volume = {16},
	issn = {2095-6975},
	abstract = {Two cyclopeptides, celogentin L (1) and its epimer lyciumin A (2) were firstly isolated from Celosia argentea L.. The planar structures of the two compounds were fully determined by spectroscopic data, including 1D-, 2D-NMR, and HR-ESI/MS. The absolute configurations of amino acid components were assigned via chiral-phase HPLC analyses after acid hydrolysis. Furthermore, the configuration of C-N linkage at the glycine C alpha was elucidated by extensive analyses of 2D-NMR and comparison of the experimental and calculated electronic circular dichroism (ECD) spectra. Cytotoxicity of the two compounds against human alveolar epithelial A549, hepatocellular carcinoma HepG2, and cervical cancer Hela cell lines was assayed. Although both of them were inactive in these cells, the present findings add new facets for the chemistry of Celosia argentea.},
	language = {English},
	number = {1},
	journal = {CHINESE JOURNAL OF NATURAL MEDICINES},
