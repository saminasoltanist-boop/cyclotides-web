@article{katoh_ribosomal_2011,
	address = {THOMAS GRAHAM HOUSE, SCIENCE PARK, MILTON RD, CAMBRIDGE CB4 0WF, CAMBS, ENGLAND},
	title = {Ribosomal synthesis of backbone macrocyclic peptides},
	volume = {47},
	issn = {1359-7345},
	doi = {10.1039/c1cc12647d},
	abstract = {A wealth of knowledge has been accumulated on ribosomal synthesis of macrocyclic peptides in the past decade. In nature, backbone cyclization of the translated linear peptides is generally catalyzed by specific enzymes, giving them peptidase resistance, thermodynamic stability and various other physiological activities. Due to these biochemical traits, backbone cyclic peptides have become an attractive resource for the discovery of drug leads. Recently, various new methodologies have also been established to generate man-made cyclic peptides. Here, we describe the biosynthetic mechanisms of naturally occurring backbone macrocyclic peptides focusing on cyclotides, sunflower trypsin inhibitors (SFTIs) and cyanobactins as well as several new emerging methodologies, such as sortase mediated ligation, protein splicing method and genetic code reprogramming.},
	language = {English},
	number = {36},
	journal = {CHEMICAL COMMUNICATIONS},
	publisher = {ROYAL SOC CHEMISTRY},
	author = {Katoh, Takayuki and Goto, Yuki and Reza, Md. Shamim and Suga, Hiroaki},
	year = {2011},
	note = {Type: Article},
	pages = {9946--9958},
}

@inproceedings{neubauerova_isolation_2011,
	address = {PO BOX 128 FARRER RD, SINGAPORE 9128, SINGAPORE},
	title = {Isolation of antimicrobial peptides from {New} {Zealand} spinach {Tetragonia} tetragonioides},
	isbn = {978-981-4354-85-1},
	abstract = {The number of resistant pathogenic microbial species has increased in the last years. In the future it seems, there will be fewer possibilities to cure multiresistant infections by existing antibiotics. This can become a great problem for public health. One of the potential solutions seems to be short cationic, mainly hydrophobic peptides synthetised as a part of innate immunity of all living organisms. In our project, leaves of New Zealand spinach (Tetragonia tetragonioides) were chosen as a source of these peptides. We used several separation techniques based to gain fractions containing low molecular peptides. Antimicrobial activity of these peptide fractions was tested against gram-positive bacteria Staphylococcus aureus (clinical isolate) and gram-negative bacteria Pseudomonas aeruginosa DBM 3081. Mass spectrometry analysis of antimicrobial active fractions proved presence of low molecular peptides with molecular masses to 5 kDa.},
	language = {English},
	booktitle = {{SCIENCE} {AND} {TECHNOLOGY} {AGAINST} {MICROBIAL} {PATHOGENS}: {RESEARCH}, {DEVELOPMENT} {AND} {EVALUATION}},
	publisher = {WORLD SCIENTIFIC PUBL CO PTE LTD},
