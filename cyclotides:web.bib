	keywords = {cyclic peptides, drug design, kalata B1, cystine knot, protein engineering, circular proteins},
	pages = {176--184},
}

@article{boy_stabilisation_2007,
	address = {VIA AURELIO SAFFI 23, 20123 MILAN, ITALY},
	title = {Stabilisation of small proteins for their use as pharmacological scaffolds - why knot?},
	volume = {25},
	issn = {0392-839X},
	abstract = {Proteins and peptlides e manifold functions in nature and have long been used as pharmacologically active compounds. A major drawback in their pharmaceutical applicability, however, is their lack of stability towards chemical, enzymatic and thermal degradation. Small knotted peptides, such as knottins and cyclotides, are newly discovered stable compounds isolated from plants, animals, fungi and bacteria. Due to their extraordinary stability, some of them even withstand treatment with boiling water. Besides disposing of a variety of natural targets and characteristics and thus potential therapeutic use, cyclotides and knottins have been used as scaffolds to create new pharmacologically active agents. Furthermore, despite their complicated knotted structure, the chemical synthesis using automated solid phase synthesis has been well established.},
