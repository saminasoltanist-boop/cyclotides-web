@article{ji-shen_chemical_2012,
	address = {16 DONGHUANGCHENGGEN NORTH ST, BEIJING 100717, PEOPLES R CHINA},
	title = {Chemical synthesis of a cyclotide via intramolecular cyclization of peptide {O}-esters},
	volume = {55},
	issn = {1674-7291},
	doi = {10.1007/s11426-011-4434-4},
	abstract = {Cyclotides constitute a fascinating family of circular proteins containing ca. 30 amino acid residues. They have a unique cyclic cysteine knot topology and exhibit remarkable thermal, chemical and enzymatic stabilities. These characteristics enable them to have a range of biological activities and promising pharmaceutical and agricultural applications. Here, we present a practical strategy for the chemical synthesis of cyclotides through the intramolecular ligation of fully unprotected peptide O-esters. This strategy involves the mild Fmoc solid-phase peptide synthesis of the peptide O-ester backbone, the head-to-tail cyclization of the cyclotide backbone by native chemical ligation, and the oxidative refolding to yield the natural knot protein. The simplicity and high efficiency of the strategy can be employed in the synthesis of artificial cyclotides for pharmaceutical applications.},
	language = {English},
	number = {1, SI},
	journal = {SCIENCE CHINA-CHEMISTRY},
	publisher = {SCIENCE PRESS},
	author = {Ji-Shen, Zheng and Hao-Nan, Chang and Jing, Shi and Lei, Liu},
	month = jan,
