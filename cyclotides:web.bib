	pages = {37--39},
}

@article{camarero_cell-based_2007,
	address = {VIALE BRIANZA 22, 20127 MILANO, ITALY},
	title = {A cell-based approach for the biosynthesis/screening of cyclic peptide libraries against bacterial toxins},
	volume = {25},
	issn = {0392-839X},
	abstract = {The currently available methods for developing and screening small drug-like molecules able to knockout toxins or pathogeic microorganisms have some limitations. In order to be useful, these new methods must provide high-throughput analysis and identify specific binders in a short period a time. To meet this need, we are developing an approach that uses living cells to generate libraries of small biomolecules, which are then screened inside the cell for activity. Our group is using this new, combined approach to find hiphly specific ligands capable of disabling anthrax Lethal Factor (LF) as proof of principle. Key to our approach is the development of a method for the biosynthesis of libraries of cyclic peptides, and an efficient screening process that con be carried out inside the cell.},
	language = {English},
	number = {3, S},
	journal = {CHIMICA OGGI-CHEMISTRY TODAY},
	publisher = {TEKNOSCIENZE PUBL},
	author = {Camarero, Julio A. and Kimura, Richard H. and Woo, Youn-Hi and Cantor, Jason and Steenblock, Erin},
	year = {2007},
	note = {Type: Article},
	pages = {20--23},
}

@article{greenwood_cyclic_2007,
	address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
	title = {The cyclic cystine knot miniprotein {MCoTI}-{II} is internalized into cells by macropinocytosis},
	volume = {39},
	issn = {1357-2725},
	doi = {10.1016/j.biocel.2007.06.016},
	abstract = {The cyclotides are macrocyclic knotted proteins characterized by a compact topology and exceptional stability. Accordingly it has been hypothesized that they may be useful as protein engineering frameworks for the stabilization and delivery of bioactive peptide sequences. This study examined the internalization of cyclotides into mammalian cells, a vital step for the delivery of bioactive peptide sequences to intracellular targets. Although the entry of various linear peptides into cells has been reported previously, this is the first report of internalization of a macrocyclic peptide. Cell uptake was examined for representatives of two cyclotide subfamilies; the first was MCoTI-II, a member of the trypsin inhibitor subfamily, which was internalized by a macrophage and breast cancer cell line and the second, the prototypic cyclotide kalata B I from the Mobius subfamily, which remained extracellular. Biotin labeled MCoTI-II entered macrophages by macropinocytosis, resulting in vesicular encapsulation without trafficking to lysosomes for degradation. The ready uptake, coupled with low cytotoxicity, indicates that MCoTI-II has the potential to transport grafted bioactivities to intracellular targets, making it a potentially valuable framework in drug design applications. (C) 2007 Elsevier Ltd. All rights reserved.},
	language = {English},
	number = {12},
	journal = {INTERNATIONAL JOURNAL OF BIOCHEMISTRY \& CELL BIOLOGY},
	publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
	author = {Greenwood, Kathryn P. and Daly, Norelle L. and Brown, Darren L. and Stow, Jennifer L. and Craik, David J.},
	year = {2007},
	note = {Type: Article},
	keywords = {cyclotides, cyclic cystine knot, cell-penetrating peptides, MCoTI-II, protein engineering},
	pages = {2252--2264},
}

