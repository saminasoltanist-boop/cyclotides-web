	editor = {Latif, MT and Ibrahim, N and Hanafiah, MM and Hasbullah, SA and Jumali, MHH and Ibrahim, K and Rasol, NHA},
	year = {2019},
	note = {Type: Proceedings Paper},
	annote = {Postgraduate Colloquium of the Faculty-of-Science-and-Technology of the Universiti-Kebangsaan-Malaysia (UKM FST), Univ Kebangsaan Malaysia, Fac Sci \& Technol, Selangor, MALAYSIA, APR 04-06, 2018},
}

@incollection{schmidt_chemoenzymatic_2019,
	address = {999 RIVERVIEW DR, STE 208, TOTOWA, NJ 07512-1165 USA},
	series = {Methods in {Molecular} {Biology}},
	title = {Chemoenzymatic {Synthesis} of {Linear}- and {Head}-to-{Tail} {Cyclic} {Peptides} {Using} {Omniligase}-1},
	volume = {2012},
	isbn = {978-1-4939-9546-2 978-1-4939-9545-5},
	issn = {1064-3745},
	doi = {10.1007/978-1-4939-9546-2_4},
	abstract = {Omniligase-1-catalyzed ligation represents a powerful tool for the efficient intermolecular and intramolecular (head-to-tail cyclization) ligation of peptides. Reactions are irreversible and proceed with unprotected peptides (mu M-mM concentration) in aqueous solution at slightly basic pH. Due to its high catalytic efficiency, only very low molar equivalents of omniligase-1 are required. In this chapter, a chemoenzymatic peptide synthesis (CEPS) approach for the assembly of medium-to-long-sized linear peptides as well as for efficient peptide head-to-tail cyclization is described. In particular, we provide protocols for the chemoenzymatic synthesis of the peptide therapeutic exenatide, a GLP-1 (glucagon-like peptide) analogue, and the macrocyclization and oxidative folding of the cyclotide MCoTI-II in a one-pot procedure.},
	language = {English},
