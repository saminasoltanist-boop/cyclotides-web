	editor = {Diederich, M},
	year = {2009},
	note = {Type: Article; Proceedings Paper},
	keywords = {apoptosis, neurodegeneration, oxidative stress, PC12 cells, Viola mandshurica},
	pages = {576--582},
	annote = {Apoptosis 2008 World - From Mechanisms to Applications, Luxembourg, LUXEMBOURG, JAN 23-26, 2008},
}

@article{picchi_cyclic_2009,
	address = {CAIXA POSTAL 26037, 05599-970 SAO PAULO, BRAZIL},
	title = {{CYCLIC} {PEPTIDE} {FROM} {PLANT} {BIOMASS}: {CHEMICAL} {FEATURES} {AND} {DIVERSITY}, {BIOSYNTHESIS} {AND} {BIOLOGICAL} {ACTIVITIES}},
	volume = {32},
	issn = {0100-4042},
	doi = {10.1590/S0100-40422009000500033},
	abstract = {CYCLIC PEPTIDE FROM PLANT BIOMASS: CHEMICAL FEATURES AND DIVERSITY, BIOSYNTHESIS AND BIOLOGICAL ACTIVITIES. Natural peptides are outstanding as the most promising macromolecules in the search for new drugs, especially those of cyclic nature. The higher plants revealed a very peculiar composition of their cyclic peptides, which distinguish themselves by a “head-to-tail” cyclization. It is possible to define two groups of cyclic peptides from plant biomass. Those called in this review as Eucyclopeptides formed by 2-12 amino acid, and Cyclotides considered as circular polypeptides, composed of 29-37 amino acid that retain three disulfides bridges in an arrangement known as cyclic cystine knot. Searching for plant peptides should form into a subject for scientific research in the forefront of great importance for bioprospecting natural products macromolecular.},
	language = {Portuguese},
	number = {5},
	journal = {QUIMICA NOVA},
	publisher = {SOC BRASILEIRA QUIMICA},
	author = {Picchi, Douglas Gatte and Altei, Wanessa Fernanda and Saito, Monica Sue and Bolzani, Vanderlan da Silva and Cilli, Eduardo Maffud},
	year = {2009},
	note = {Backup Publisher: Soc Brasileira Quim
Type: Article; Proceedings Paper},
	keywords = {cyclic peptides, cyclotides, eucyclopeptides},
	pages = {1262--1277},
	annote = {32nd Annual Meeting of the Sociedade-Brasileira-de-Quimica, Fortaleza, BRAZIL, MAY 30-JUN 02, 2009},
}

