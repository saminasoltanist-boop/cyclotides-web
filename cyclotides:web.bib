	editor = {MendezVilas, A},
	year = {2011},
	note = {Type: Proceedings Paper},
	keywords = {antimicrobial peptides, isolation, Tetragonia tetragonioides},
	pages = {13--17},
	annote = {International Conference on Antimicrobial Research, Valladolid, SPAIN, NOV 03-05, 2010},
}

