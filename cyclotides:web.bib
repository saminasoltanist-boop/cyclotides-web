@article{goransson_reversible_2004,
	address = {1155 16TH ST, NW, WASHINGTON, DC 20036 USA},
	title = {Reversible antifouling effect of the cyclotide cycloviolacin {O2} against barnacles},
	volume = {67},
	issn = {0163-3864},
	doi = {10.1021/np0499719},
	abstract = {Cycloviolacin O2, a plant peptide of the cyclotide family, is shown to have potent effects against fouling barnacles (Balanus improvisus), with complete inhibition of settlement at a concentration of 0.25 muM. The effect of cycloviolacin O2 against barnacles is reversible and nontoxic in the bioassay employed in these studies. Cycloviolacin O2 was isolated from the terrestrial plant Viola odorata by strong cation exchange and reversed-phase HPLC and identified by mass spectrometry following aminoethylation and enzymatic cleavage.},
