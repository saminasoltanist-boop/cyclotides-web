@incollection{oguis_natural_2015,
	address = {24-28 OVAL ROAD, LONDON NW1 7DX, ENGLAND},
	series = {Advances in {Botanical} {Research}},
	title = {Natural {Functions} and {Structure}-{Activity} {Relationships} of {Cyclotides}},
