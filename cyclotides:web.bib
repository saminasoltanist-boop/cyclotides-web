@article{cemazar_oxidative_2008,
	address = {140 HUGUENOT STREET, 3RD FL, NEW ROCHELLE, NY 10801 USA},
	title = {Oxidative folding of cyclic cystine knot proteins},
	volume = {10},
	issn = {1523-0864},
	doi = {10.1089/ars.2007.1849},
	abstract = {Cyclic cystine knot proteins are small but topologically complex molecules that occur naturally in plants and have a wide range of bioactivities that make them interesting from a pharmaceutical perspective. Their remarkable stability is dependent on the correct formation of a knotted arrangement of disulfide bonds. This review reports on studies that have deciphered the pathways to the “tying of the knot.” These studies have involved a range of biophysical techniques and suggest that the major intermediate species presented on these pathways are two disulfide native species, which are not necessarily the precursors of the native protein. Structural elucidations of one analogue and one such intermediate have been reported, and they both show highly native-like conformation and native disulfide bond connectivity. Cyclic cystine knot formation has also been shown to be assisted by protein disulfide isomerase. The points summarized in this review will be important to consider in the design of novel pharmaceutically interesting biomolecules based on the cyclic cystine knot motif, which has shown potential as a molecular scaffold because of its exceptional stability.},
	language = {English},
	number = {1},
	journal = {ANTIOXIDANTS \& REDOX SIGNALING},
	publisher = {MARY ANN LIEBERT, INC},
	author = {Cemazar, Masa and Gruber, Christian W. and Craik, David J.},
	month = jan,
	year = {2008},
	note = {Type: Review},
	pages = {103--111},
}

@article{doernenburg_effect_2008,
	address = {VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
	title = {Effect of irradiation intensity on cell growth and kalata {B1} accumulation in {Oldenlandia} affinis cultures},
	volume = {92},
	issn = {0167-6857},
	doi = {10.1007/s11240-007-9309-1},
	abstract = {Light irradiation had remarkable effects on callus growth of Oldenlandia affinis with an optimum intensity of 35 mu mol m(-2) (-1)supercript stop. Biosynthesis of kalata B1, the main cyclic peptide in O. affinis, was induced and triggered with rising irradiation intensities. The highest concentration of kalata B1, 0.49 mg g(-1)supercript stop DW characterised by the maximum productivity of 3.88 mu g per litre and day was analysed at 120 mu mol m(-2) (-1)supercript stop, although callus growth was repressed. The light saturation point was established to be 35 mu mol m(-2) (-1)supercript stop, where kalata B1 productivity was in a similar order (3.41 mu g per day) due to the higher growth index. O. affinis suspension cultures were shown to accumulate comparable specific kalata B1 concentrations in a delayed growth associated production pattern. These were dependent on irradiation intensity (0.16 mg g(-1) at 2 mu mol m(-2) (-1); 0.28 mg g(-1) at 35 mu mol m(-2-1)). The batch cultivation process resulted in a maximum productivity of 27.30 mu g per litre and day with culture doubling times of 1.16 d(-1). Submers operation represented a 8-fold product enhancement compared to callus cultivation.},
	language = {English},
	number = {1},
	journal = {PLANT CELL TISSUE AND ORGAN CULTURE},
	publisher = {SPRINGER},
	author = {Doernenburg, Heike and Seydel, Peter},
	month = jan,
	year = {2008},
	note = {Type: Article},
	keywords = {cyclotides, kalata B1, callus cultures, light stress, oldenlandia affinis, suspension cultures},
	pages = {93--99},
}

@article{gran_cyclic_2008,
	address = {PO BOX 10 11 61, D-69451 WEINHEIM, GERMANY},
	title = {Cyclic {Peptides} from {Oldenlandia} affinis {DC}. {Molecular} and {Biological} {Properties}},
	volume = {5},
	issn = {1612-1872},
	doi = {10.1002/cbdv.200890184},
	abstract = {A new isolation procedure for Kalata polypeptides from the tropical plant Oldenlandia affinis DC is described. Fractions were screened by thin-layer chromatography, and Van Urk positive fractions were, tested for oxytocic activity in estrogenized rat uteri. By using this procedure, we were able to isolate and characterize three macrocyclic polypeptides With uterine activity. Their amino acid sequence and biological effects have been analyzed. and their NMR spectra were compared with those of the earlier ones. All three peptides showed hemolytic activity on human blood, and were tested for antibiotic effect against E. coli, Staphylococcus aureus. and Hemophilus influenzae.},
	language = {English},
