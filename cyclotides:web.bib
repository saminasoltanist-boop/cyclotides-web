}

@article{gould_recombinant_2012,
	address = {THOMAS GRAHAM HOUSE, SCIENCE PARK, MILTON RD, CAMBRIDGE CB4 0WF, CAMBS, ENGLAND},
	title = {Recombinant production of rhesus θ-defensin-1 ({RTD}-1) using a bacterial expression system},
	volume = {8},
	issn = {1742-206X},
	doi = {10.1039/c2mb05451e},
	abstract = {Defensins are antimicrobial peptides that are important in the innate immune defense of mammals. In contrast to mammalian alpha-and beta-defensins, rhesus theta-defensin-1 (RTD-1) comprises only 18 amino acids stabilized by three disulfide bonds and an unusual backbone cyclic topology. In this work we report for the first time the recombinant expression of the fully folded theta-defensin RTD-1 using a bacterial expression system. This was accomplished using an intramolecular native chemical ligation in combination with a modified protein-splicing unit. RTD-1 was produced either in vitro or in vivo. In-cell production of RTD-1 was estimated to reach an intracellular concentration of similar to 4 mu M. Recombinant RTD-1 was shown to be correctly folded as characterized by heteronuclear-NMR and by its ability to specifically inhibit lethal factor protease. The recombinant production of folded theta-defensins opens the possibility to produce peptide libraries based on this peptide scaffold that could be used to develop in-cell screening and directed evolution technologies.},
	language = {English},
	number = {4},
	journal = {MOLECULAR BIOSYSTEMS},
	publisher = {ROYAL SOC CHEMISTRY},
	author = {Gould, Andrew and Li, Yilong and Majumder, Subhabrata and Garcia, Angie E. and Carlsson, Patrick and Shekhtman, Alexander and Camarero, Julio A.},
	year = {2012},
	note = {Type: Article},
	pages = {1359--1365},
}

